{
  "name": "typescript-test-automation",
  "version": "0.1.0",
  "description": "A TypeScript based software test automation platform",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "pnpm run /^lint:.*/",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:types": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "security": "pnpm audit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
